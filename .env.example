# Internal signature builder (/internal/signatures, or internal.khyte.se).
# Basic-auth credentials enforced in src/proxy.ts. Required in production —
# without SIGNATURE_TOOL_USER set, the route returns 401 to everyone.
SIGNATURE_TOOL_USER=
SIGNATURE_TOOL_PASSWORD=

# Origin prepended to signature image paths in the copied-to-clipboard HTML.
# Defaults to https://www.khyte.se (the canonical host — the apex redirects,
# and mail clients often will not follow a redirect for an image).
# Only set this if the assets in
# /public/signature-assets are served from a different host (e.g. a CDN).
SIGNATURE_ASSET_ORIGIN=
